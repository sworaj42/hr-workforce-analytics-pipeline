# Copy to .env and adjust. .env is gitignored.

# Warehouse database (bronze / silver / gold schemas)
# localhost when running from your machine; warehouse-db from inside Docker
POSTGRES_HOST=localhost
POSTGRES_USER=hr_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hr_warehouse
# Port on your machine; inside Docker it is always 5432
POSTGRES_HOST_PORT=5433

# MinIO landing zone (console: http://localhost:9001)
# Password must be at least 8 characters
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=landing
# localhost:9000 from your machine; minio:9000 from inside Docker
MINIO_ENDPOINT=localhost:9000

# Airflow (UI: http://localhost:8080)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
# Generate: docker run --rm apache/airflow:3.3.0 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Any long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
